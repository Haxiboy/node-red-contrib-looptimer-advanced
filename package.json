{
  "name": "node-red-contrib-looptimer-advanced",
  "version": "1.0.0",
  "description": "Sends the msg through the first output, then continues to do so in a loop, once per the duration specified, until a payload of 'stop' or 'STOP' is received. Supports override with messages!",
  "main": "looptimer_advanced.js",
  "scripts": {
    "test": "mocha \"test/**/*.test.js\""
  },
  "keywords": [
    "node-red",
    "loop",
    "timer",
    "advanced",
    "looptimer",
    "node-red-contrib",
    "pause",
    "resume",
    "repeat",
    "interval"
  ],
  "author": "Haxiboy",
  "license": "Apache-2.0",
  "node-red": {
    "version": ">=3.0.0",
    "nodes": {
      "looptimer-advanced": "looptimer_advanced.js"
    }
  },
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Haxiboy/node-red-contrib-looptimer-advanced.git"
  },
  "bugs": {
    "url": "https://github.com/Haxiboy/node-red-contrib-looptimer-advanced/issues"
  },
  "homepage": "https://github.com/Haxiboy/node-red-contrib-looptimer-advanced#readme",
  "devDependencies": {
    "mocha": "^12.0.3",
    "node-red": "^5.0.8",
    "node-red-node-test-helper": "^0.3.6",
    "should": "^13.2.3"
  },
  "files": [
    "looptimer_advanced.js",
    "looptimer_advanced.html",
    "icons",
    "examples",
    "README.md",
    "LICENSE"
  ]
}
